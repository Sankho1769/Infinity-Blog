APP_ENV=development
APP_DEBUG=true
APP_BASE_URL=http://localhost
SESSION_SECURE_COOKIE=false
# Generate a unique value with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_KEY=replace-with-64-character-random-hex-key

DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=infinity_blog
DB_USERNAME=blog_runtime
DB_PASSWORD=replace-with-a-local-secret
# Loopback development may leave this empty. Remote hosts and all production
# connections require a readable trusted MySQL CA certificate path.
DB_SSL_CA=

# Optional summary provider settings. Leave unset to keep summary generation disabled.
# The initial adapter supports the OpenAI Responses API at its fixed HTTPS endpoint.
# AI_PROVIDER=openai
# AI_MODEL=replace-with-enabled-model-id
# AI_API_KEY=replace-with-a-server-side-secret
# AI_TIMEOUT_SECONDS=20
# AI_MAX_INPUT_CHARS=12000
# AI_MAX_OUTPUT_CHARS=1000
# AI_SUMMARY_RATE_LIMIT=10

# Optional, separate account used only by bin/migrate.php.
# Leave unset to use the DB_* account for local development.
# MIGRATION_DB_USERNAME=blog_migrator
# MIGRATION_DB_PASSWORD=replace-with-a-local-migration-secret
# MIGRATION_DB_SSL_CA=/protected/path/to/mysql-ca.pem

# Optional Supabase Storage configuration.
# Leave unset or with placeholders to use safe local fallback storage.
# SUPABASE_URL=https://replace-with-project-ref.supabase.co
# SUPABASE_SECRET_KEY=replace-with-supabase-service-role-secret-key
# SUPABASE_BUCKET_ARTICLES=article-images
# SUPABASE_BUCKET_AVATARS=profile-avatars
# SUPABASE_BUCKET_BANNERS=profile-banners
# SUPABASE_BUCKET_VIDEOS=article-videos
