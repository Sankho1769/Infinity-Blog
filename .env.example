# Infinity Blog Environment Configuration Template
# Copy to .env for local overrides (never commit .env)

APP_ENV=development
APP_DEBUG=true

# Database Configuration (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=infinity_blog

# Initial Provisioning Passwords (required in production, min 12 chars)
ADMIN_DEFAULT_PASSWORD=
AUTHOR_DEFAULT_PASSWORD=

# Reverse Proxy Trust Configuration (comma-separated list of trusted upstream IP addresses)
# Leave blank when not operating behind a reverse proxy (e.g. Nginx, Cloudflare, AWS ALB)
TRUSTED_PROXIES=

# Allowed Origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# Optional Gemini AI Summarizer Configuration
# Leave blank to use built-in extractive plain-text summarizer
GEMINI_API_KEY=
