APP_ENV=development
APP_DEBUG=true
APP_BASE_URL=http://localhost
SESSION_SECURE_COOKIE=false
# Generate a unique value with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_KEY=replace-with-64-character-random-hex-key

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=infinity_blog
DB_USERNAME=blog_runtime
DB_PASSWORD=replace-with-a-local-secret
# Loopback development may leave this empty. Remote hosts and all production
# connections require a readable trusted MySQL CA certificate path.
DB_SSL_CA=

# Optional, separate account used only by bin/migrate.php.
# Leave unset to use the DB_* account for local development.
# MIGRATION_DB_USERNAME=blog_migrator
# MIGRATION_DB_PASSWORD=replace-with-a-local-migration-secret
# MIGRATION_DB_SSL_CA=/protected/path/to/mysql-ca.pem
