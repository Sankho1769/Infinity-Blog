# Infinity Blog Root Web Configuration

# Disable directory browsing
Options -Indexes

# Protect sensitive environment and source control files (.env, .git, etc.)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# Protect documentation, markdown, and config files from direct exposure
<FilesMatch "\.(md|sql|json|lock|env|example|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>
